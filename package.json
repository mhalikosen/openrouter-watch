{
  "name": "openrouter-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Watches OpenRouter model endpoints and mails when a provider's price, throughput or latency changes",
  "imports": {
    "#*": "./dist/*"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "oxlint --type-aware src/ && prettier --check \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node --enable-source-maps dist/main.js",
    "once": "nest build && node --enable-source-maps --env-file-if-exists=.env dist/main.js --once",
    "test": "nest build && node --test \"dist/**/*.spec.js\""
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "24.x",
    "pnpm": "12.x"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/schedule": "^12.0.2",
    "axios": "^1.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cron": "^4.4.0",
    "nodemailer": "^10.0.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@types/node": "^24.13.6",
    "@types/nodemailer": "^8.0.2",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3"
  }
}
